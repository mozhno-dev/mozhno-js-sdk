{
  "name": "@mozhno/client-js",
  "version": "1.0.0",
  "description": "Feature flag evaluation for browser and Node.js — local, no-network-per-check, fail-closed.",
  "type": "module",
  "main": "./dist/mozhno-client.cjs",
  "module": "./dist/mozhno-client.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/mozhno-dev/mozhno-js-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mozhno-client.mjs",
      "require": "./dist/mozhno-client.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": ["feature-flags", "feature-toggles", "mozhno", "sdk"],
  "license": "Apache-2.0",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.62.1",
    "prettier": "^3.8.4",
    "eslint-config-prettier": "^10.1.8"
  }
}
